# =============================================================================
# Venture Research (BORE) — variables de entorno de ejemplo
#
# Uso:  cp .env.example .env   y edita los valores. `.env` NUNCA se versiona.
# Sin OPENAI_API_KEY la aplicación funciona solo en modo demo offline
# (datos ficticios, marcados como tales); nunca simula investigación real.
# =============================================================================

# -----------------------------------------------------------------------------
# Proveedor OpenAI (modo real)
# -----------------------------------------------------------------------------
# Clave de la API de OpenAI (https://platform.openai.com/api-keys).
# Formato: sk-proj-...  Déjala vacía para usar solo el modo offline.
OPENAI_API_KEY=

# Modelos (obligatorios en modo real; el código nunca los fija como literales).
# Deben estar disponibles en la Responses API. Los de investigación y revisión
# necesitan soportar la herramienta hospedada `web_search`.
# Valores de ejemplo según el catálogo oficial de OpenAI (nov-2026):
#   - Investigación: equilibrio calidad/coste con búsqueda web.
#   - Análisis (estructurar, juez de evidencia, evaluación por criterio): sin
#     herramientas, alto volumen → modelo eficiente.
#   - Revisión crítica: se recomienda un modelo DISTINTO del de análisis.
BORE_MODEL_RESEARCH=gpt-6.1-sol
BORE_MODEL_ANALYSIS=gpt-6-luna
BORE_MODEL_REVIEW=gpt-6.1-sol

# Contexto recuperado por cada búsqueda web: low | medium | high (influye en coste).
BORE_SEARCH_CONTEXT_SIZE=medium
# Turnos máximos por ejecución de agente del SDK.
BORE_AGENT_MAX_TURNS=10

# Ejecución de humo de pago (sección 0.5 de la spec): 1 permite UNA ejecución
# real con limits.max_usd <= 1.0 y los tests `integration_external`.
BORE_ALLOW_PAID_SMOKE=0

# -----------------------------------------------------------------------------
# Trazas del OpenAI Agents SDK (desactivadas por defecto; se envían a OpenAI)
# -----------------------------------------------------------------------------
OPENAI_AGENTS_DISABLE_TRACING=1
# 1 = activar trazas (no disponibles con Zero Data Retention).
BORE_TRACING_ENABLED=0
# 1 = incluir entradas/salidas de los modelos en las trazas.
BORE_TRACE_INCLUDE_SENSITIVE_DATA=0

# -----------------------------------------------------------------------------
# Límites de gasto y de creación de ejecuciones
# -----------------------------------------------------------------------------
# Gasto máximo diario (UTC) en USD de ejecuciones reales; al superarlo no se
# pueden crear ejecuciones nuevas. Las ejecuciones demo no cuentan.
BORE_MAX_USD_PER_DAY=25
# Segundos mínimos entre creaciones de ejecución (limitación de frecuencia).
BORE_MIN_SECONDS_BETWEEN_RUNS=60

# -----------------------------------------------------------------------------
# API, interfaz web y seguridad
# -----------------------------------------------------------------------------
# URL de la API usada por la CLI (`bore research/status/export`).
BORE_API_URL=http://127.0.0.1:8000
# Cabeceras Host y Origin permitidas (separadas por coma). `api` es el nombre
# del servicio dentro de Docker Compose.
BORE_ALLOWED_HOSTS=127.0.0.1,localhost,api,testserver
BORE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Clave para firmar el token CSRF de los formularios. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Vacía -> clave aleatoria por proceso (aviso en el log; los formularios
# abiertos dejan de valer al reiniciar la API).
BORE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Infraestructura (Docker Compose)
# -----------------------------------------------------------------------------
# PostgreSQL y Redis no se publican en el host; solo son accesibles dentro de
# la red de Compose. Cambia la contraseña y mantén DATABASE_URL coherente.
POSTGRES_USER=bore
POSTGRES_PASSWORD=bore
POSTGRES_DB=bore
DATABASE_URL=postgresql+psycopg://bore:bore@postgres:5432/bore
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Worker (sección 9.4)
# -----------------------------------------------------------------------------
# Ejecución `running` sin latido durante más de N s -> failed / worker_lost.
BORE_HEARTBEAT_STALE_SECONDS=120
# Ejecución `queued` sin trabajo asociado durante más de N s -> se reencola una vez.
BORE_REQUEUE_AFTER_SECONDS=300
# Frecuencia de la comprobación de ejecuciones huérfanas.
BORE_REAPER_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Verificador de fuentes HTTP (sección 4.3): una GET por URL citada
# -----------------------------------------------------------------------------
# User-Agent identificable; incluye un contacto propio si lo usas en real.
VERIFIER_USER_AGENT=BORE-SourceVerifier/1.0 (+research bot)
VERIFIER_TIMEOUT_SECONDS=15
# Tamaño máximo descargado por página (bytes). 2097152 = 2 MB.
VERIFIER_MAX_BYTES=2097152
VERIFIER_MAX_REDIRECTS=5
# 1 = respetar robots.txt (no desactivar en uso real).
VERIFIER_RESPECT_ROBOTS=1
# Segundos mínimos entre peticiones al mismo host.
VERIFIER_PER_HOST_MIN_INTERVAL=1

# -----------------------------------------------------------------------------
# Tests (opcionales; la suite en Compose ya las define)
# -----------------------------------------------------------------------------
# BORE_TEST_DATABASE_URL=postgresql+psycopg://bore:bore@postgres:5432/bore_test
# BORE_TEST_REDIS_URL=redis://redis:6379/1
# URL de la aplicación para los E2E de Playwright (`uv run pytest -m e2e`).
# BORE_E2E_BASE_URL=http://127.0.0.1:8000
