# --- Proveedor OpenAI (modo real; vacío = solo modo offline) ---
OPENAI_API_KEY=
# Permite UNA ejecución de humo de pago con limits.max_usd <= 1.0 (sección 0.5 de la spec)
BORE_ALLOW_PAID_SMOKE=0
# Modelos: OBLIGATORIOS en modo real; nunca literales en el código.
BORE_MODEL_RESEARCH=
BORE_MODEL_ANALYSIS=
# Se recomienda un modelo de revisión distinto del de análisis
BORE_MODEL_REVIEW=

# --- Trazas del Agents SDK (desactivadas por defecto) ---
OPENAI_AGENTS_DISABLE_TRACING=1
BORE_TRACING_ENABLED=0
BORE_TRACE_INCLUDE_SENSITIVE_DATA=0

# --- Límites ---
BORE_MAX_USD_PER_DAY=25
BORE_MIN_SECONDS_BETWEEN_RUNS=60

# --- API ---
BORE_API_URL=http://127.0.0.1:8000
# Hosts/Orígenes permitidos (separados por coma)
BORE_ALLOWED_HOSTS=127.0.0.1,localhost,api,testserver
BORE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Infraestructura ---
DATABASE_URL=postgresql+psycopg://bore:bore@postgres:5432/bore
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=bore
POSTGRES_PASSWORD=bore
POSTGRES_DB=bore
