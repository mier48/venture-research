# --- Proveedor OpenAI (modo real; vacío = solo modo offline) ---
OPENAI_API_KEY=
# Permite UNA ejecución de humo de pago con limits.max_usd <= 1.0 (sección 0.5 de la spec)
BORE_ALLOW_PAID_SMOKE=0
# Modelos: OBLIGATORIOS en modo real; nunca literales en el código.
BORE_MODEL_RESEARCH=
BORE_MODEL_ANALYSIS=
# Se recomienda un modelo de revisión distinto del de análisis
BORE_MODEL_REVIEW=

# --- Trazas del Agents SDK (desactivadas por defecto) ---
OPENAI_AGENTS_DISABLE_TRACING=1
BORE_TRACING_ENABLED=0
BORE_TRACE_INCLUDE_SENSITIVE_DATA=0

# --- Límites ---
BORE_MAX_USD_PER_DAY=25
BORE_MIN_SECONDS_BETWEEN_RUNS=60

# --- API ---
BORE_API_URL=http://127.0.0.1:8000
# Hosts/Orígenes permitidos (separados por coma)
BORE_ALLOWED_HOSTS=127.0.0.1,localhost,api,testserver
BORE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# --- Infraestructura ---
DATABASE_URL=postgresql+psycopg://bore:bore@postgres:5432/bore
REDIS_URL=redis://redis:6379/0
POSTGRES_USER=bore
POSTGRES_PASSWORD=bore
POSTGRES_DB=bore

# Contexto de la búsqueda web hospedada (low/medium/high; afecta al coste)
BORE_SEARCH_CONTEXT_SIZE=medium
# Turnos máximos por ejecución de agente del SDK
BORE_AGENT_MAX_TURNS=10
# Mantenimiento del worker (9.4): running sin latido > este valor -> worker_lost
BORE_HEARTBEAT_STALE_SECONDS=120
# queued sin job asociado > este valor -> reencolar una vez
BORE_REQUEUE_AFTER_SECONDS=300
# Intervalo del hilo reaper del worker
BORE_REAPER_INTERVAL_SECONDS=60
# Verificador de fuentes HTTP (4.3)
VERIFIER_USER_AGENT=BORE-SourceVerifier/1.0 (+research bot)
VERIFIER_TIMEOUT_SECONDS=15
VERIFIER_MAX_BYTES=2097152
VERIFIER_MAX_REDIRECTS=5
VERIFIER_RESPECT_ROBOTS=1
VERIFIER_PER_HOST_MIN_INTERVAL=1
# Clave para firmar el token CSRF de la UI (generar: python -c "import secrets;print(secrets.token_hex(32))").
# Vacío -> clave aleatoria por proceso con warning en el log.
BORE_SECRET_KEY=
